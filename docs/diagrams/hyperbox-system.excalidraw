    {
      "type": "text",
      "id": "gc_sub",
      "x": 2490,
      "y": 246,
      "width": 840,
      "height": 36,
      "text": "a daemon thread named 'hyperbox-gc', started by serve()\nsweeps immediately, then every GC_INTERVAL_SECONDS = 300s",
      "originalText": "a daemon thread named 'hyperbox-gc', started by serve()\nsweeps immediately, then every GC_INTERVAL_SECONDS = 300s",
