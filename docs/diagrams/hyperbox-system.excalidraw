    {
      "type": "text",
      "id": "gc_why",
      "x": 2490,
      "y": 296,
      "width": 850,
      "height": 54,
      "text": "Ownership used to be a dict in one process. A restart lost the sandbox while\nthe container kept running \u2014 5 failures in 10 alternating between two live\nprocesses, plus orphans that destroy_sandbox cheerfully called 'already_gone'.",
      "originalText": "Ownership used to be a dict in one process. A restart lost the sandbox while\nthe container kept running \u2014 5 failures in 10 alternating between two live\nprocesses, plus orphans that destroy_sandbox cheerfully called 'already_gone'.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
