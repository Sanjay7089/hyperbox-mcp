    },
    {
      "type": "text",
      "id": "sql_body",
      "x": 2512,
      "y": 1646,
      "width": 810,
      "height": 150,
      "text": "CREATE TABLE sandboxes (\n  sandbox_id    TEXT PRIMARY KEY,\n  container_ref TEXT NOT NULL,  -- opaque: the runtime's own reattach payload\n  language      TEXT NOT NULL,\n  backend       TEXT NOT NULL,\n  created_at    REAL NOT NULL,\n  last_used_at  REAL NOT NULL,\n  expires_at    REAL NOT NULL,  -- pushed out by touch() on every run\n  state         TEXT NOT NULL   -- 'creating' | 'ready'\n);",
      "originalText": "CREATE TABLE sandboxes (\n  sandbox_id    TEXT PRIMARY KEY,\n  container_ref TEXT NOT NULL,  -- opaque: the runtime's own reattach payload\n  language      TEXT NOT NULL,\n  backend       TEXT NOT NULL,\n  created_at    REAL NOT NULL,\n  last_used_at  REAL NOT NULL,\n  expires_at    REAL NOT NULL,  -- pushed out by touch() on every run\n  state         TEXT NOT NULL   -- 'creating' | 'ready'\n);",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 710027,
      "version": 1,
      "versionNonce": 710028,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "sql_note",
      "x": 2512,
      "y": 1808,
      "width": 810,
      "height": 34,
      "text": "~/.hyperbox/state/locks/<sandbox_id>.lock \u2014 one flock file per sandbox, so work on\none never blocks another. Never deleted by design; recreated on demand.",
      "originalText": "~/.hyperbox/state/locks/<sandbox_id>.lock \u2014 one flock file per sandbox, so work on\none never blocks another. Never deleted by design; recreated on demand.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#93c5fd",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 710029,
      "version": 1,
