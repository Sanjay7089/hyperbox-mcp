    {
      "type": "text",
      "id": "proto_body_r",
      "x": 1760,
      "y": 1276,
      "width": 520,
      "height": 130,
      "text": "@dataclass ExecResult\n  stdout \u00b7 stderr \u00b7 exit_code \u00b7 timed_out\n  success = exit_code == 0\n            and not timed_out\n\n@dataclass SandboxHandle\n  sandbox_id \u00b7 language \u00b7 backend\n  meta = {\"container_ref\": \"...\"}",
      "originalText": "@dataclass ExecResult\n  stdout \u00b7 stderr \u00b7 exit_code \u00b7 timed_out\n  success = exit_code == 0\n            and not timed_out\n\n@dataclass SandboxHandle\n  sandbox_id \u00b7 language \u00b7 backend\n  meta = {\"container_ref\": \"...\"}",
