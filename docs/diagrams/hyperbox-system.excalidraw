    {
      "type": "text",
      "id": "hostcfg_body",
      "x": 1240,
      "y": 2242,
      "width": 480,
      "height": 180,
      "text": "{\"Image\":\"python:3.12-slim\",\n \"Cmd\":[\"sleep\",\"infinity\"],\n \"Labels\":{\"hyperbox-mcp.managed\":\"true\",\n           \"hyperbox-mcp.id\":\"a3f2c1d0e9b8\"},\n \"HostConfig\":{\n   \"Memory\":1073741824,\n   \"PidsLimit\":128,\n   \"NanoCpus\":1000000000,\n   \"Tmpfs\":{\"/work\":\"rw,size=64m,mode=1777\"},\n   \"SecurityOpt\":[\"no-new-privileges\"]}}",
      "originalText": "{\"Image\":\"python:3.12-slim\",\n \"Cmd\":[\"sleep\",\"infinity\"],\n \"Labels\":{\"hyperbox-mcp.managed\":\"true\",\n           \"hyperbox-mcp.id\":\"a3f2c1d0e9b8\"},\n \"HostConfig\":{\n   \"Memory\":1073741824,\n   \"PidsLimit\":128,\n   \"NanoCpus\":1000000000,\n   \"Tmpfs\":{\"/work\":\"rw,size=64m,mode=1777\"},\n   \"SecurityOpt\":[\"no-new-privileges\"]}}",
