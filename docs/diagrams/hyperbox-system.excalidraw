    },
    {
      "type": "text",
      "id": "gc_b2",
      "x": 2560,
      "y": 870,
      "width": 790,
      "height": 105,
      "text": "registry.stale_reservations()\n  SELECT * FROM sandboxes WHERE expires_at <= now AND state = 'creating'\nA create that died between reserve() and finalize() \u2014 the server killed,\nthe engine dropping, a pull that never returned. Drop the ROW only: the\ncontainer, if one was ever made, still carries our labels, so Pass 3\nreclaims it. Removing the row first is what makes it visible to Pass 3.",
      "originalText": "registry.stale_reservations()\n  SELECT * FROM sandboxes WHERE expires_at <= now AND state = 'creating'\nA create that died between reserve() and finalize() \u2014 the server killed,\nthe engine dropping, a pull that never returned. Drop the ROW only: the\ncontainer, if one was ever made, still carries our labels, so Pass 3\nreclaims it. Removing the row first is what makes it visible to Pass 3.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 700049,
      "version": 1,
      "versionNonce": 700050,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
