    {
      "type": "text",
      "id": "gc_b1",
      "x": 2560,
      "y": 654,
      "width": 790,
      "height": 170,
      "text": "registry.expired_records()\n  SELECT * FROM sandboxes WHERE expires_at <= now AND state = 'ready'\nfor each record:\n  with registry.lock(sandbox_id):        <- flock, one file per sandbox\n      re-read the row INSIDE the lock\n      no longer expired, or already gone -> skip\n          (a run() in another process touched it since the query)\n      runtime.destroy(handle)\n      registry.remove(sandbox_id)\n  EngineUnavailableError -> KEEP the row, and try again next sweep",
      "originalText": "registry.expired_records()\n  SELECT * FROM sandboxes WHERE expires_at <= now AND state = 'ready'\nfor each record:\n  with registry.lock(sandbox_id):        <- flock, one file per sandbox\n      re-read the row INSIDE the lock\n      no longer expired, or already gone -> skip\n          (a run() in another process touched it since the query)\n      runtime.destroy(handle)\n      registry.remove(sandbox_id)\n  EngineUnavailableError -> KEEP the row, and try again next sweep",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 700043,
      "version": 1,
      "versionNonce": 700044,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
