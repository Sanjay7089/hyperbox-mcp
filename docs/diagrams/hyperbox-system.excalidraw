    },
    {
      "type": "text",
      "id": "ctr_limits",
      "x": 580,
      "y": 2550,
      "width": 580,
      "height": 56,
      "text": "1 GiB  \u00b7  1 CPU  \u00b7  128 PIDs  \u00b7  no-new-privileges\nhost filesystem: NOT mounted  \u00b7  engine socket: NOT mounted\nfiles and packages persist between runs; variables do not",
      "originalText": "1 GiB  \u00b7  1 CPU  \u00b7  128 PIDs  \u00b7  no-new-privileges\nhost filesystem: NOT mounted  \u00b7  engine socket: NOT mounted\nfiles and packages persist between runs; variables do not",
