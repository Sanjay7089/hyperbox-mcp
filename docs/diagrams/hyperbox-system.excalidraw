    {
      "type": "text",
      "id": "tp_note",
      "x": 2490,
      "y": 1550,
      "width": 850,
      "height": 36,
      "text": "Either process can destroy a sandbox the other created; neither can collect one\nthe other is running code in, because both take the same per-sandbox flock.",
      "originalText": "Either process can destroy a sandbox the other created; neither can collect one\nthe other is running code in, because both take the same per-sandbox flock.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
