    {
      "type": "text",
      "id": "tp_title",
      "x": 2490,
      "y": 1270,
      "width": 800,
      "height": 20,
      "text": "sandboxes outlive the process that created them",
      "originalText": "sandboxes outlive the process that created them",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
