    {
      "type": "text",
      "id": "mod_legend",
      "x": 150,
      "y": 946,
      "width": 820,
      "height": 100,
      "text": "validate.py   every caller value checked BEFORE anything is allocated\npolicy.py     1g \u00b7 1 cpu \u00b7 128 pids \u00b7 60s \u00b7 20k chars \u2014 no tool raises them\nregistry.py   SQLite (WAL) ownership, shared by every server process",
      "originalText": "validate.py   every caller value checked BEFORE anything is allocated\npolicy.py     1g \u00b7 1 cpu \u00b7 128 pids \u00b7 60s \u00b7 20k chars \u2014 no tool raises them\nregistry.py   SQLite (WAL) ownership, shared by every server process",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300061,
      "version": 1,
      "versionNonce": 300062,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "band_b_invariant",
      "x": 150,
      "y": 1040,
      "width": 1600,
      "height": 22,
      "text": "every tool body follows one order:   validate  ->  take the per-sandbox lock  ->  RE-READ the record inside it  ->  act",
      "originalText": "every tool body follows one order:   validate  ->  take the per-sandbox lock  ->  RE-READ the record inside it  ->  act",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300063,
      "version": 1,
      "versionNonce": 300064,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "mod_legend_r",
      "x": 1010,
      "y": 946,
      "width": 820,
      "height": 100,
      "text": "slots.py      cross-process ticket queue: max 4 heavy engine ops at once\nengine.py     which engine is reachable, and the address of its socket\nerrors.py     one structured failure shape: message + fix + context",
      "originalText": "slots.py      cross-process ticket queue: max 4 heavy engine ops at once\nengine.py     which engine is reachable, and the address of its socket\nerrors.py     one structured failure shape: message + fix + context",
