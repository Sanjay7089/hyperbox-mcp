    },
    {
      "type": "text",
      "id": "ctr_exec",
      "x": 580,
      "y": 2462,
      "width": 580,
      "height": 72,
      "text": "keepalive:  sleep infinity \u2014 a command WE choose, never\n            whatever CMD the image happens to carry\neach run:   sh -c 'echo $$ > pid; exec python3 /sandbox/x.py'\n            a timeout kills the process GROUP, and verifies it",
      "originalText": "keepalive:  sleep infinity \u2014 a command WE choose, never\n            whatever CMD the image happens to carry\neach run:   sh -c 'echo $$ > pid; exec python3 /sandbox/x.py'\n            a timeout kills the process GROUP, and verifies it",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
