    {
      "type": "text",
      "id": "caps_box_body",
      "x": 1898,
      "y": 740,
      "width": 390,
      "height": 204,
      "text": "{\"languages\":[\"bash\",\"go\",\"java\",\n   \"javascript\",\"python\"],\n \"backends\":[\"auto\",\"docker\",\"podman\"],\n \"limits\":{\"memory\":\"1g\",\"cpus\":1.0,\n   \"max_processes\":128,\n   \"max_timeout_seconds\":60.0,\n   \"max_output_chars_per_stream\":20000,\n   \"max_libraries\":25,\n   \"inactivity_ttl_seconds\":1800},\n \"network\":{\"while_your_code_runs\":\n   \"disabled\"},\n \"filesystem\":{\"host_filesystem\":\n   \"not mounted\",\"scratch_space\":[\"/work\"],\n   \"scratch_size\":\"64m\"}}",
      "originalText": "{\"languages\":[\"bash\",\"go\",\"java\",\n   \"javascript\",\"python\"],\n \"backends\":[\"auto\",\"docker\",\"podman\"],\n \"limits\":{\"memory\":\"1g\",\"cpus\":1.0,\n   \"max_processes\":128,\n   \"max_timeout_seconds\":60.0,\n   \"max_output_chars_per_stream\":20000,\n   \"max_libraries\":25,\n   \"inactivity_ttl_seconds\":1800},\n \"network\":{\"while_your_code_runs\":\n   \"disabled\"},\n \"filesystem\":{\"host_filesystem\":\n   \"not mounted\",\"scratch_space\":[\"/work\"],\n   \"scratch_size\":\"64m\"}}",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
