    {
      "type": "text",
      "id": "sql_hdr",
      "x": 2512,
      "y": 1624,
      "width": 800,
      "height": 16,
      "text": "~/.hyperbox/state/registry.db   \u2014   journal_mode=WAL, busy_timeout=10000",
      "originalText": "~/.hyperbox/state/registry.db   \u2014   journal_mode=WAL, busy_timeout=10000",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#93c5fd",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
