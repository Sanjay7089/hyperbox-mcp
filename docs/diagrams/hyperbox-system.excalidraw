    {
      "type": "text",
      "id": "proto_body_l",
      "x": 1162,
      "y": 1276,
      "width": 540,
      "height": 130,
      "text": "class Runtime(Protocol):\n  def supported_languages() -> tuple[str, ...]\n  def create(language, backend, sandbox_id,\n             environment) -> SandboxHandle\n  def run(handle, code, libraries,\n          timeout) -> ExecResult\n  def destroy(handle) -> None\n  def alive(handle) -> bool\n  def gc(known_ids: set[str]) -> list[str]",
      "originalText": "class Runtime(Protocol):\n  def supported_languages() -> tuple[str, ...]\n  def create(language, backend, sandbox_id,\n             environment) -> SandboxHandle\n  def run(handle, code, libraries,\n          timeout) -> ExecResult\n  def destroy(handle) -> None\n  def alive(handle) -> bool\n  def gc(known_ids: set[str]) -> list[str]",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
