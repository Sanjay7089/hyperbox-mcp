    {
      "type": "text",
      "id": "proto_rules",
      "x": 1162,
      "y": 1424,
      "width": 1120,
      "height": 54,
      "text": "# meta is OPAQUE above this line: the registry stores it verbatim \u2014 which is how a NEW server\n# process rebuilds a working handle for a sandbox it never created.\n# `from llm_sandbox import ...` anywhere above this line is a bug, not a shortcut.",
      "originalText": "# meta is OPAQUE above this line: the registry stores it verbatim \u2014 which is how a NEW server\n# process rebuilds a working handle for a sandbox it never created.\n# `from llm_sandbox import ...` anywhere above this line is a bug, not a shortcut.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#93c5fd",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
