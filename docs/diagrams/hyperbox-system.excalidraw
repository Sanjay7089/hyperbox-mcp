    {
      "type": "text",
      "id": "gc_h1",
      "x": 2536,
      "y": 628,
      "width": 800,
      "height": 20,
      "text": "PASS 1 \u2014 ready sandboxes past their inactivity TTL",
      "originalText": "PASS 1 \u2014 ready sandboxes past their inactivity TTL",
