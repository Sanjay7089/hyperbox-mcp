    {
      "type": "text",
      "id": "endp_paths",
      "x": 1202,
      "y": 1796,
      "width": 420,
      "height": 195,
      "text": "POST   /v1.44/containers/create\nPOST   /v1.44/containers/{id}/start\nGET    /v1.44/containers/{id}/json\nPOST   /v1.44/containers/{id}/exec\nPOST   /v1.44/exec/{id}/start\nGET    /v1.44/exec/{id}/json\nPUT    /v1.44/containers/{id}/archive\nPOST   /v1.44/networks/{n}/disconnect\nPOST   /v1.44/networks/{n}/connect\nPOST   /v1.44/images/create?fromImage=\nGET    /v1.44/containers/json?filters=\nDELETE /v1.44/containers/{id}?force=true",
      "originalText": "POST   /v1.44/containers/create\nPOST   /v1.44/containers/{id}/start\nGET    /v1.44/containers/{id}/json\nPOST   /v1.44/containers/{id}/exec\nPOST   /v1.44/exec/{id}/start\nGET    /v1.44/exec/{id}/json\nPUT    /v1.44/containers/{id}/archive\nPOST   /v1.44/networks/{n}/disconnect\nPOST   /v1.44/networks/{n}/connect\nPOST   /v1.44/images/create?fromImage=\nGET    /v1.44/containers/json?filters=\nDELETE /v1.44/containers/{id}?force=true",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
